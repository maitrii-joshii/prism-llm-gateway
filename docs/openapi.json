{
  "openapi": "3.1.0",
  "info": {
    "title": "Prism LLM Gateway",
    "description": "Production-grade AI gateway with multi-provider routing, fallback, semantic caching, token metering, and observability.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health Check",
        "description": "Return application health status.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": ["Models"],
        "summary": "List Models",
        "description": "Return the list of available models and aliases.",
        "operationId": "list_models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {"type": "string", "example": "list"},
                    "data": {"type": "array", "items": {"type": "object"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Observability"],
        "summary": "Get Prometheus Metrics",
        "description": "Export Prometheus-compatible metrics for monitoring.",
        "operationId": "get_prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Prometheus text formatted metrics",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": ["Chat"],
        "summary": "Create Chat Completion",
        "description": "OpenAI-compatible chat completion endpoint with routing, caching, and fallback.",
        "operationId": "chat_completions_v1_chat_completions_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Tenant virtual API key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {
                    "type": "string",
                    "example": "fast",
                    "description": "Model alias (fast, smart, auto) or direct model name"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {"type": "string", "example": "user"},
                        "content": {"type": "string", "example": "Hello!"}
                      }
                    }
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false,
                    "description": "Stream tokens as SSE events"
                  },
                  "temperature": {"type": "number", "default": 1.0},
                  "max_tokens": {"type": "integer"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OpenAI chat completion response or SSE stream",
            "headers": {
              "x-prism-request-id": {"schema": {"type": "string"}},
              "x-prism-provider": {"schema": {"type": "string"}},
              "x-prism-cache": {"schema": {"type": "string", "example": "hit | miss | skip"}},
              "x-prism-fallback": {"schema": {"type": "string", "example": "true | false"}},
              "x-prism-cost-usd": {"schema": {"type": "string", "example": "0.000000"}}
            }
          },
          "401": {"description": "Authentication failure (invalid or missing key)"},
          "403": {"description": "Model not allowed for this key"},
          "429": {"description": "Rate limit exceeded or budget exhausted"},
          "502": {"description": "Upstream provider error"}
        }
      }
    },
    "/admin/usage": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get Tenant Usage",
        "description": "Get aggregated monthly usage metrics across virtual keys.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string", "example": "Bearer admin-token"}
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "example": "2026-11"}
          }
        ],
        "responses": {
          "200": {"description": "Usage summary per virtual key"},
          "401": {"description": "Invalid admin token"}
        }
      }
    },
    "/admin/logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get Request Logs",
        "description": "Get detailed request audit logs with pagination.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string", "example": "Bearer admin-token"}
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "default": 50}
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "default": 0}
          }
        ],
        "responses": {
          "200": {"description": "List of recent request logs"},
          "401": {"description": "Invalid admin token"}
        }
      }
    },
    "/admin/cache/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get Cache Stats",
        "description": "Get semantic cache entries count, hits, and hit rate.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string", "example": "Bearer admin-token"}
          }
        ],
        "responses": {
          "200": {"description": "Cache statistics"},
          "401": {"description": "Invalid admin token"}
        }
      }
    }
  }
}

